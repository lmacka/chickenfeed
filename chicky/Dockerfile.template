FROM balenalib/raspberrypi5-debian-python:3.11-bookworm

# Set environment variables for non-interactive apt installations
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    python3-smbus \
    i2c-tools \
    python3-pip \
    python3-numpy \
    build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install Node.js dependencies
RUN npm install

# Install Python dependencies - following Pimoroni's approach
# The key is to install pre-built packages where possible
RUN pip3 install --no-cache-dir --extra-index-url https://www.piwheels.org/simple \
    automationhat \
    smbus2 \
    gpiozero \
    lgpio \
    rpi-lgpio

# Copy application code
COPY . .

# Make sure the Python scripts are executable
RUN chmod +x light.py servocontrol.py test_servo_lgpio.py

# Enable I2C and SPI
RUN echo "dtparam=i2c_arm=on" >> /boot/config.txt || true
RUN echo "dtparam=spi=on" >> /boot/config.txt || true

# Set environment variables
ENV NODE_ENV=production
ENV UDEV=on

# Start the application
CMD ["node", "server.js"] 