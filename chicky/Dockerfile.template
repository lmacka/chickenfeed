FROM balenalib/%%BALENA_MACHINE_NAME%%-python:3.11-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3-smbus \
    python3-spidev \
    python3-aiohttp \
    python3-pydantic \
    python3-fastapi \
    python3-uvicorn \
    python3-socketio \
    python3-apscheduler \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies from piwheels
RUN pip install --extra-index-url=https://piwheels.org/simple --no-cache-dir -r requirements.txt

# Copy the rest of the application
COPY . .

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Run the application
CMD ["python", "main.py"] 