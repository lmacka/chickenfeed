# secrets
**/.env
*.env
!*.env.example

# swag runtime state (certs, keys, fail2ban, logs) - container-generated.
# git cannot re-include a file inside an ignored DIRECTORY, so each parent has
# to be un-ignored step by step for site-confs/ to actually be tracked.
v2/vps/swag-config/*
!v2/vps/swag-config/nginx/
v2/vps/swag-config/nginx/*
!v2/vps/swag-config/nginx/site-confs/
vps/swag-config/

# tailscale state, volumes
**/tailscale/
vps/data/
vps/config/

# tooling / editor
.claude/
*.log
*.swp
.DS_Store

# mediamtx.yml holds the SRT publish passphrase; template is mediamtx.yml.example
v2/vps/mediamtx.yml

# compiled output. The retired chook-server binary was committed once at 16 MB;
# build artefacts do not belong in the repo.
v2/app/chook-app
*.exe
*.bin
