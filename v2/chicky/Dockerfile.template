FROM balenalib/%%BALENA_MACHINE_NAME%%-python:3.11-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3-smbus \
    python3-spidev \
    python3-aiohttp \
    python3-pydantic \
    python3-fastapi \
    python3-uvicorn \
    python3-socketio \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies from piwheels
RUN pip install --extra-index-url=https://piwheels.org/simple --no-cache-dir python-multipart==0.0.6 && \
    pip install --extra-index-url=https://piwheels.org/simple --no-cache-dir smbus2==0.4.3 && \
    pip install --extra-index-url=https://piwheels.org/simple --no-cache-dir pimoroni-bme280 ads1x15-adc rpi-lgpio && \
    pip install --extra-index-url=https://piwheels.org/simple --no-cache-dir automationhat==1.0.0 || true

# MQTT bridge + daylight gate. Installed explicitly (not via -r requirements.txt)
# to match how the hardware deps above are pinned; both are pure Python.
RUN pip install --extra-index-url=https://piwheels.org/simple --no-cache-dir \
    paho-mqtt==2.1.0 astral==3.2

# Copy the rest of the application
COPY . .

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=3000

# Run the application
CMD ["python3", "main.py"]
