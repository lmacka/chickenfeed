###############################################
# chook.cam video relay
#
# The cluster PUSHES here over SRT. This box never reaches into the home
# network: that reach-in dependency is what took chook.cam down for months.
#
# Video-only by design. WebRTC cannot carry AAC, and mediamtx has been
# observed to panic and exit when a WHEP viewer connects to a stream that
# carries an AAC track. The publisher must send -an.
###############################################
logLevel: info

# --- ingest ---
srt: true
srtAddress: :8890

# --- egress ---
webrtc: true
webrtcAddress: :8889
webrtcLocalUDPAddress: :8189
webrtcAdditionalHosts: [103.100.38.128]
webrtcAllowOrigins: ['*']
webrtcTrustedProxies: [172.16.0.0/12]

hls: true
hlsAddress: :8888
# mpegts, not lowLatency: on this 15fps source LL-HLS part durations vary and
# mediamtx warns that will error on iOS clients. WebRTC is the low-latency path.
hlsVariant: mpegts
hlsAllowOrigins: ['*']
hlsTrustedProxies: [172.16.0.0/12]
# Keep the HLS muxer running continuously instead of starting it on demand.
# The Tapo's clock jumps backwards periodically; ffmpeg clamps the DTS and a
# muxer started mid-stream then dies with "unable to extract DTS: too many
# reordered frames". Starting once with the stream and staying up avoids
# repeatedly re-entering that state on every viewer request.
hlsAlwaysRemux: true

# --- unused ingest/egress, kept off to shrink the surface ---
rtsp: false
rtmp: false
api: false

metrics: true
metricsAddress: :9998

# Defining authInternalUsers REPLACES the built-in defaults, so the public
# read entry has to be restated here. The default only permits the metrics
# action from 127.0.0.1, which nginx (on the docker bridge) is not, so the
# scrape 401'd until the bridge was added.
authInternalUsers:
  # Reading is public: this is a public livestream.
  #
  # Publishing is NOT, and must never be granted to 'any'. srtPublishPassphrase
  # does NOT gate it: the passphrase applies only to the SRT ingest, while WHIP
  # (WebRTC publish) is a separate door onto the same path, and mediamtx
  # defaults to overridePublisher. Granting publish to 'any' lets a stranger
  # POST to /<path>/whip, evict the real feed, and serve their own video from
  # this domain.
  #
  # mediamtx consults auth for AuthActionPublish BEFORE checking the SRT
  # passphrase, so the real publisher depends on the entry below. Do not merge
  # these two back together.
  - user: any
    pass:
    permissions:
      - action: read

  # The publisher. Credentials ride in the SRT streamid
  # (#!::m=publish,r=coop,u=...,s=...); note the password key is 's', not 'p'.
  - user: publisher
    pass: CHANGEME
    permissions:
      - action: publish
        path: coop
  # Metrics scrape, reachable only from localhost and the docker bridge.
  # nginx puts HTTP basic auth in front of it before it reaches the internet.
  - user: any
    pass:
    ips: ["127.0.0.1", "::1", "172.16.0.0/12"]
    permissions:
      - action: api
      - action: metrics
      - action: pprof

paths:
  coop:
    # NOTE: this file holds a secret, so it is gitignored and NOT in the public
    # repo. See mediamtx.yml.example for the committed template.
    # Per-path env overrides (MTX_PATHS_COOP_...) are NOT usable: mediamtx
    # 1.19.3 panics with "reflect.Value.Addr of unaddressable value" when
    # descending into the paths map.
    srtPublishPassphrase: CHANGEME-set-a-real-passphrase
