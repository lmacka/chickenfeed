# The only variable docker-compose.yml interpolates.
# Used by swag to register the Let's Encrypt account.
SWAG_EMAIL=

# Not here: the SRT publish passphrase. It lives in mediamtx.yml
# (gitignored, see mediamtx.yml.example). Setting it through an
# MTX_ environment variable panics mediamtx.

# JWT signing secret for remark42 (the guestbook). Any long random string:
#   openssl rand -hex 32
REMARK_SECRET=
